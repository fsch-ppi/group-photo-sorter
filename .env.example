# Django Settings
# IMPORTANT: Generate a secure key with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=your-super-secret-key-change-in-production
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com

# Redis for Celery (no need to change if using docker-compose)
REDIS_URL=redis://redis:6379/0

# Nextcloud Configuration (REQUIRED)
NEXTCLOUD_URL=https://your-nextcloud-instance.com
NEXTCLOUD_CLIENT_ID=your-oauth-client-id
NEXTCLOUD_CLIENT_SECRET=your-oauth-client-secret

# Frontend URL (for CORS and redirects)
# Use the public HTTPS URL where users access your app
# Note: Using port 8444 for HTTPS since 443 is often in use
FRONTEND_URL=https://your-domain.com:8444

# SSL Certificate paths (Let's Encrypt)
# These are mounted into the container
SSL_CERT_PATH=/etc/letsencrypt/live/your-domain.com/fullchain.pem
SSL_KEY_PATH=/etc/letsencrypt/live/your-domain.com/privkey.pem

# File upload settings
MAX_UPLOAD_SIZE_MB=5120
TEMP_UPLOAD_DIR=/tmp/photo_import_uploads
# Cleanup temp files older than this many hours (0 = immediate after processing)
TEMP_FILE_MAX_AGE_HOURS=24

# Conversion settings
JPEG_QUALITY=92
VIDEO_CRF=18

# Resource Limits (optional, disabled by default)
# Enable to prevent Celery workers from consuming too many resources during video conversion
ENABLE_RESOURCE_LIMITS=false
# Maximum memory per Celery worker (e.g., 4G, 8G)
CELERY_MEMORY_LIMIT=4G
# CPU limit per Celery worker (e.g., 2.0 = 2 CPU cores)
CELERY_CPU_LIMIT=2.0
